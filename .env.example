# Supabase Configuration
# Required: Project URL (found in Project Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Required: Service role secret key (bypasses RLS to insert into leads table from Server Actions)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Email Notifications (Optional)
# API key from resend.com for sending email notifications upon form submission
RESEND_API_KEY="re_123456789"

# Recipient email for new lead alerts (defaults to contact@hopfieldlabs.com if omitted)
NOTIFICATION_EMAIL="contact@hopfieldlabs.com"
